rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Published Skins
    match /skins/{skinId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.base64Png is string
        && request.resource.data.modelType in ['classic', 'slim'];
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // Skin Comments
    match /comments/{skinId}/messages/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // Reports
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string;
      allow read, update, delete: if false; // Admin only via console
    }
  }
}
