rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Published Skins
    match /skins/{skinId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.base64Png is string
        && request.resource.data.modelType in ['classic', 'slim'];
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;

      // Skin Ratings
      match /ratings/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Skin Comments
    match /comments/{skinId}/messages/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // Direct Messages & Conversations
    match /conversations/{convId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;

      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      }
    }

    // Global Community Chat
    match /global_chat/{msgId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 400;
      allow update, delete: if false;
    }

    // Reports (Moderation)
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['inappropriate', 'spam', 'harassment', 'stolen', 'other'];
      allow read, update, delete: if false; // Admin console only
    }
  }
}
